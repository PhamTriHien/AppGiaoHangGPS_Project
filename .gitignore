# Flutter / Dart build & tool artifacts
# Local Graphify index and extraction caches
graphify-out/
.graphify_*

**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/pubspec.lock

# Android / Gradle / iOS / Windows ephemeral files
**/android/.gradle/
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/ios/Pods/
**/ios/.symlinks/
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/
**/macos/Flutter/ephemeral/

# IDE & OS temporary files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db
~$*.docx

# Environment secrets & local runtime SQLite DB
.env
*.env
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm
