PORT=8787

# Các origin được phép gọi API, phân tách bằng dấu phẩy.
WEB_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Token quản trị native loopback. Cloud dùng Supabase không bắt buộc biến này.
# Không dùng lại mật khẩu Gmail hoặc đưa token vào web build.
RELAY_TOKEN=thay-bang-token-ngau-nhien-dai

# Gmail SMTP: dùng App Password, không dùng mật khẩu Gmail thường.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password

# Optional integrations. Keep existing Gmail/Google settings when adding these.
BIND_HOST=127.0.0.1
PHOTON_BASE_URL=
PHOTON_AUTOCOMPLETE=false
TRACKASIA_API_KEY=
TRACKASIA_ENABLED=false
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_ENABLED=false
OSRM_BASE_URL=https://router.project-osrm.org/
VROOM_BASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
DELIVERY_WEBHOOK_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=
TURNSTILE_ENFORCE_OTP=false
PUBLIC_BASE_URL=http://127.0.0.1:8787
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=false
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Central settings; Admin overrides these values in the ignored config file.
# On cloud, set this to a file on a persistent volume before saving in Admin.
INTEGRATION_CONFIG_PATH=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ENABLED=true
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_BRANDNAME=
SMS_ENABLED=false
SMTP_ENABLED=true
SUPABASE_ENABLED=true
PHOTON_ENABLED=true
OSRM_ENABLED=true
BANKS_ENABLED=true
WEATHER_ENABLED=true
OCR_ENABLED=true
VROOM_ENABLED=true
FIREBASE_ENABLED=true
TURNSTILE_ENABLED=true
GEMINI_ENABLED=true
GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api/
GHN_TOKEN=
GHN_SHOP_ID=
GHN_WEBHOOK_SECRET=
GHN_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://127.0.0.1:8080/#/cloud
PAYOS_CANCEL_URL=http://127.0.0.1:8080/#/cloud
PAYOS_ENABLED=false
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
MEILISEARCH_URL=
MEILISEARCH_MASTER_KEY=
MEILISEARCH_ENABLED=false
# PostgreSQL from Supabase Connect. Can be saved through verified cloud Admin.
DATABASE_URL=
# Optional PEM root CA, normally managed through Admin backend settings.
DATABASE_CA_CERT=
# Public app base for expiring tracking links (HTTPS in deployment).
PUBLIC_APP_URL=
# Enable only after installing the operations migration and reviewing deadlines.
MARKET_JOBS_ENABLED=true
